# ==== LLM sağlayıcı ====
# Varsayılan "mistral" (3 katman): kısa/context'siz sorular Groq'a, gerisi
# mistral-small; small tıkanırsa mistral-medium'a düşer.
LLM_PROVIDER=mistral

# Mistral (ana motor + fallback) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-2506
# MISTRAL_MODEL_FALLBACK=mistral-medium-2505

# Groq hız şeridi (kısa sorular) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_FAST_LANE_TOKENS=1000

