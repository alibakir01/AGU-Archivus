# Streamlit Community Cloud → Settings → Secrets bölümüne BU içeriği yapıştır
# (gerçek anahtarlarla). Yerelde bunun yerine .env kullanılır.
#
# secrets.toml ASLA git'e commit edilmez (.gitignore korur).

VOYAGE_AI_KEY = "pa-..."
PINECONE_API_KEY = "pcsk_..."

# LLM sağlayıcı seçenekleri:
#   "mistral"    → 3 katman: kısa/context'siz sorular Groq hız şeridine,
#                  normal sorular mistral-small-2506, small tıkanırsa
#                  mistral-medium-2505'e düşer (ÖNERİLEN)
#   "groq"       → sadece Groq
#   "openrouter" → sadece OpenRouter
#   "auto"       → legacy: önce Groq, hata olursa OpenRouter
LLM_PROVIDER = "mistral"

# Mistral ana motor + fallback (LLM_PROVIDER=mistral için zorunlu):
MISTRAL_API_KEY = "..."
# MISTRAL_MODEL = "mistral-small-2506"
# MISTRAL_MODEL_FALLBACK = "mistral-medium-2505"

# Groq hız şeridi (kısa sorular için; anahtar yoksa şerit devre dışı kalır):
GROQ_API_KEY = "gsk_..."
# GROQ_FAST_LANE_TOKENS = "1000"

# (opsiyonel) OpenRouter — sadece LLM_PROVIDER=openrouter/auto için:
# OPENROUTER_API_KEY = "sk-or-..."
# OPENROUTER_MODEL = "openai/gpt-oss-120b:free"

# (opsiyonel) Rate limit — kullanıcı başına dakikada soru hakkı (varsayılan 6):
# RATE_LIMIT_PER_MIN = "6"

# (opsiyonel) Bakım modu — "1" yapıp Reboot deyince kullanıcılar "bakımdayız"
# ekranı görür (hata ayıklarken kullan). Kapatmak için "0" yap ya da sil.
# MAINTENANCE_MODE = "0"
# MAINTENANCE_MESSAGE = "Bakımdayız, birazdan döneriz 🙂"

# ==== Feedback → Google Sheets (👍/👎 kaydı) ====
# Hedef E-Tablo ID'si (tablo URL'inde /d/ ile /edit arasındaki uzun kod):
FEEDBACK_SHEET_ID = "1AbC...."
# Google service account JSON anahtarının TÜM alanlarını buraya taşı.
# Kurulum: Google Cloud → proje → "Google Sheets API"yi etkinleştir → Service Account
# oluştur → JSON indir. Sonra E-Tabloyu client_email adresine "Editör" olarak paylaş.
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "feedback-bot@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
